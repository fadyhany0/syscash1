<Window x:Class="MarknCodePOS.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المنتجات" Height="600" Width="1000"
        Background="#f4f4f4" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Orientation="Horizontal" Background="#222" Height="50" VerticalAlignment="Center">
            <TextBlock Text="📦 إدارة المنتجات" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="15,0"/>
        </StackPanel>

        <!-- المحتوى -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- إدخال بيانات المنتج -->
            <StackPanel Grid.Column="0" Background="White" Padding="15" CornerRadius="10" Margin="0,0,10,0">
                <TextBlock Text="اسم المنتج:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="سعر الشراء:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBuyPrice" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="سعر البيع:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSellPrice" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="الكمية:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtQuantity" Height="30" Margin="0,0,0,10"/>

                <Button Content="➕ إضافة منتج" Click="btnAdd_Click" Background="#28a745" Foreground="White" Height="40" FontWeight="Bold"/>
            </StackPanel>

            <!-- جدول عرض المنتجات -->
            <DataGrid x:Name="dgProducts" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="100"/>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="سعر الشراء" Binding="{Binding CostPrice}" Width="100"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding PriceRetail}" Width="100"/>
                    <DataGridTextColumn Header="سعر الجملة" Binding="{Binding PriceWholesale}" Width="100"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Stock}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
