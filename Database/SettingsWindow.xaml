<Window x:Class="MarknCodePOS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات" Height="500" Width="600"
        Background="#f4f4f4" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Orientation="Horizontal" Background="#222" Height="50" VerticalAlignment="Center">
            <TextBlock Text="⚙️ الإعدادات" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="15,0"/>
        </StackPanel>

        <!-- محتوى الإعدادات -->
        <ScrollViewer Grid.Row="1" Margin="0,15,0,15">
            <StackPanel>
                <!-- معلومات الشركة -->
                <GroupBox Header="معلومات الشركة" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="اسم الشركة:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtCompanyName" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5"/>

                        <TextBlock Text="عنوان الشركة:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtCompanyAddress" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5"/>

                        <TextBlock Text="رقم الهاتف:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtCompanyPhone" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,5"/>
                    </Grid>
                </GroupBox>

                <!-- إعدادات المبيعات -->
                <GroupBox Header="إعدادات المبيعات" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="نسبة الضريبة (%):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtTaxRate" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5" Text="15"/>

                        <TextBlock Text="العملة:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtCurrency" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5" Text="ريال"/>
                    </Grid>
                </GroupBox>

                <!-- إعدادات النظام -->
                <GroupBox Header="إعدادات النظام" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="يمكنك تخصيص إعدادات النظام من هنا" Foreground="Gray" TextAlignment="Center" Margin="0,10"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="💾 حفظ" Click="btnSave_Click" Background="#28a745" Foreground="White" Width="100" Height="35" Margin="5" FontWeight="Bold"/>
            <Button Content="🔄 إعادة تعيين" Click="btnReset_Click" Background="#ffc107" Foreground="Black" Width="120" Height="35" Margin="5" FontWeight="Bold"/>
            <Button Content="💿 نسخة احتياطية" Click="btnBackup_Click" Background="#17a2b8" Foreground="White" Width="120" Height="35" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
