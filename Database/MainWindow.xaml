<Window x:Class="MarknCodePOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarknCode POS" Height="720" Width="1280"
        Background="#f4f4f4" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Orientation="Horizontal" Background="#222" Height="50" VerticalAlignment="Center">
            <TextBlock Text="💳 MarknCode POS" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="15,0"/>
        </StackPanel>

        <!-- محتوى الشاشة -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- إدخال البيانات -->
            <StackPanel Grid.Column="0" Background="White" Padding="15" CornerRadius="10" Margin="0,0,10,0">
                <TextBlock Text="اسم العميل:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCustomer" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="البحث عن المنتج:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSearch" Height="30" TextChanged="txtSearch_TextChanged" Margin="0,0,0,10"/>

                <ListBox x:Name="lstProducts" Height="400" SelectionChanged="lstProducts_SelectionChanged"/>
            </StackPanel>

            <!-- السلة -->
            <StackPanel Grid.Column="1" Background="White" Padding="15" CornerRadius="10">
                <TextBlock Text="سلة المشتريات" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <DataGrid x:Name="dgCart" AutoGenerateColumns="False" Height="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Qty}" Width="80"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding SellPrice}" Width="100"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock Text="الإجمالي: " FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="txtTotal" Text="0.00" FontSize="16" Foreground="Green"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- الأزرار -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="💾 حفظ الفاتورة" Click="btnSave_Click" Background="#28a745" Foreground="White" Width="150" Height="40" Margin="5" FontWeight="Bold"/>
            <Button Content="🗑 مسح السلة" Click="btnClear_Click" Background="#dc3545" Foreground="White" Width="150" Height="40" Margin="5" FontWeight="Bold"/>
            <Button Content="📦 المنتجات" Click="btnProducts_Click" Background="#6f42c1" Foreground="White" Width="150" Height="40" Margin="5" FontWeight="Bold"/>
            <Button Content="📜 تقارير" Click="btnReports_Click" Background="#007bff" Foreground="White" Width="150" Height="40" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
