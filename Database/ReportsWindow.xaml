<Window x:Class="MarknCodePOS.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التقارير" Height="700" Width="1200"
        Background="#f4f4f4" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Orientation="Horizontal" Background="#222" Height="50" VerticalAlignment="Center">
            <TextBlock Text="📊 التقارير" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="15,0"/>
        </StackPanel>

        <!-- ملخص الإحصائيات -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="White" Padding="15" CornerRadius="10" Margin="5">
                <TextBlock Text="إجمالي المبيعات" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtTotalSales" Text="0.00" FontSize="24" Foreground="Green" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Background="White" Padding="15" CornerRadius="10" Margin="5">
                <TextBlock Text="إجمالي الأرباح" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtTotalProfit" Text="0.00" FontSize="24" Foreground="Blue" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Background="White" Padding="15" CornerRadius="10" Margin="5">
                <TextBlock Text="عدد الفواتير" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtInvoiceCount" Text="0" FontSize="24" Foreground="Orange" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Background="White" Padding="15" CornerRadius="10" Margin="5">
                <TextBlock Text="هامش الربح" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtProfitMargin" Text="0.00%" FontSize="24" Foreground="Purple" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- التقارير التفصيلية -->
        <TabControl Grid.Row="2" Margin="0,10,0,10">
            <TabItem Header="تقرير المبيعات">
                <DataGrid x:Name="dgSales" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="150"/>
                        <DataGridTextColumn Header="الربح" Binding="{Binding Profit}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="تقرير المنتجات">
                <DataGrid x:Name="dgProducts" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الكمية المتوفرة" Binding="{Binding Stock}" Width="120"/>
                        <DataGridTextColumn Header="سعر الشراء" Binding="{Binding CostPrice}" Width="120"/>
                        <DataGridTextColumn Header="سعر البيع" Binding="{Binding PriceRetail}" Width="120"/>
                        <DataGridTextColumn Header="سعر الجملة" Binding="{Binding PriceWholesale}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- الأزرار -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="🔄 تحديث" Click="btnRefresh_Click" Background="#17a2b8" Foreground="White" Width="120" Height="35" Margin="5" FontWeight="Bold"/>
            <Button Content="📥 تصدير CSV" Click="btnExport_Click" Background="#28a745" Foreground="White" Width="120" Height="35" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
